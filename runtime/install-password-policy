#!/usr/bin/python
import hashlib
import os
from pathlib import Path
import re
import stat
import tempfile

if os.geteuid() != 0:
    raise SystemExit("Run the reviewed root-owned installer through graphical authorization.")

module = Path("/usr/lib/security/pam_pwquality.so")
if not module.is_file() or module.stat().st_uid != 0:
    raise SystemExit("The native, root-owned pam_pwquality module is required.")
header = module.read_bytes()[:20]
if header[:4] != b"\x7fELF" or int.from_bytes(header[18:20], "little") != 183:
    raise SystemExit("pam_pwquality must be native ARM64, not an emulated module.")

target = Path("/etc/pam.d/system-auth")
alias = Path("/etc/pam.d/common-password")
backup = Path("/etc/pam.d/system-auth.intune-arm64-backup")
rule = "password required pam_pwquality.so retry=3 minlen=12 dcredit=-1 ucredit=-1 lcredit=-1 ocredit=-1\n"
original = target.read_bytes()
lines = original.decode().splitlines(keepends=True)

if alias.exists() or alias.is_symlink():
    if not alias.is_symlink() or os.readlink(alias) != "system-auth":
        raise SystemExit("An existing common-password file conflicts with the approved alias.")

password_lines = [i for i, line in enumerate(lines) if line.split() and line.split()[0] in ("password", "-password")]
unix_lines = [i for i in password_lines if "pam_unix.so" in lines[i].split()]
quality_lines = [i for i in password_lines if "pam_pwquality.so" in lines[i].split()]
if len(unix_lines) != 1 or not password_lines:
    raise SystemExit("Unexpected password stack; refusing to rewrite PAM.")

index = unix_lines[0]
if quality_lines:
    if len(quality_lines) != 1 or lines[quality_lines[0]] != rule or "use_authtok" not in lines[index].split():
        raise SystemExit("An existing password-quality configuration requires manual review.")
    updated = original
else:
    if lines[index].split() != ["password", "required", "pam_unix.so", "try_first_pass", "nullok", "shadow"]:
        raise SystemExit("Unexpected pam_unix password options; refusing to rewrite PAM.")
    lines[index] = re.sub(r"\btry_first_pass\b", "use_authtok", lines[index], count=1)
    lines.insert(password_lines[0], rule)
    updated = "".join(lines).encode()

def non_password_content(content):
    return b"".join(line for line in content.splitlines(keepends=True)
                    if not line.split() or line.split()[0] not in (b"password", b"-password"))

if non_password_content(original) != non_password_content(updated):
    raise SystemExit("Authentication/account/session stacks would change; refusing.")

preserved = [Path("/etc/pam.d/sudo"), Path("/etc/pam.d/sddm"), Path("/etc/sddm.conf.d/autologin.conf")]
hashes = {p: hashlib.sha256(p.read_bytes()).digest() for p in preserved if p.exists()}
if updated != original:
    if backup.exists():
        raise SystemExit("A previous PAM backup exists; refusing to overwrite it.")
    with backup.open("xb") as stream:
        os.chmod(backup, 0o600)
        stream.write(original)
        stream.flush()
        os.fsync(stream.fileno())
    info = target.stat()
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=target.parent, prefix=".intune-password-", delete=False) as stream:
            temporary = Path(stream.name)
            os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
            os.fchown(stream.fileno(), info.st_uid, info.st_gid)
            stream.write(updated)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()

if not alias.is_symlink():
    alias.symlink_to("system-auth")
if target.read_bytes() != updated or alias.read_bytes() != updated:
    raise SystemExit("Password policy verification failed.")
if any(hashlib.sha256(p.read_bytes()).digest() != digest for p, digest in hashes.items()):
    raise SystemExit("An authentication/autologin file changed unexpectedly.")

print("Native password-change policy enabled; common-password aliases the same effective stack.")
print("Authentication/account/session stacks, sudo, SDDM and autologin files are unchanged.")
print(f"Original system-auth retained at {backup}.")
