[Unit]
Description=Experimental ARM64 Microsoft Identity Device Broker

[Service]
Type=dbus
BusName=com.microsoft.identity.devicebroker1
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 /opt/intune-arm64/device-broker-run
StateDirectory=intune-arm64
StateDirectoryMode=0700
RuntimeDirectory=intune-arm64
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/microsoft/identity-broker
TimeoutStartSec=60
