diff --git a/src/wrapped/wrappedseccomp.c b/src/wrapped/wrappedseccomp.c
new file mode 100644
index 0000000..11e493e
--- /dev/null
+++ b/src/wrapped/wrappedseccomp.c
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+#define _GNU_SOURCE
+#include <errno.h>
+#include <seccomp.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "wrappedlibs.h"
+#include "wrapper.h"
+#include "bridge.h"
+#include "librarian/library_private.h"
+#include "x64emu.h"
+#include "emu/x64emu_private.h"
+#include "debug.h"
+
+const char* seccompName = "libseccomp.so.2";
+#define LIBNAME seccomp
+
+_Static_assert(sizeof(struct scmp_arg_cmp) == 24, "Unexpected seccomp argument ABI");
+
+EXPORT int my_seccomp_rule_add(x64emu_t* emu, void* ctx, uint32_t action,
+                              int syscall_number, unsigned int count, void* varargs)
+{
+    (void)varargs;
+    if(count > 6) {
+        printf_log(LOG_NONE, "Invalid seccomp comparison count: %u\n", count);
+        return -EINVAL;
+    }
+    char* name = seccomp_syscall_resolve_num_arch(SCMP_ARCH_X86_64, syscall_number);
+    if(!name) {
+        printf_log(LOG_NONE, "Unknown x86-64 seccomp syscall: %d\n", syscall_number);
+        return -EDOM;
+    }
+    int native_number = seccomp_syscall_resolve_name(name);
+    if(native_number == __NR_SCMP_ERROR) {
+        printf_log(LOG_NONE, "No native seccomp mapping for %s\n", name);
+        free(name);
+        return -EDOM;
+    }
+    free(name);
+    // x86-64 passes these 24-byte variadic structs entirely on the stack.
+    const struct scmp_arg_cmp* arguments =
+        count ? (const struct scmp_arg_cmp*)(emu->regs[_SP].q[0] + 8) : NULL;
+    return seccomp_rule_add_array(ctx, action, native_number, count, arguments);
+}
+
+#include "wrappedlib_init.h"
