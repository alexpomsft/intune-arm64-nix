#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import subprocess
import tempfile


def unit_argument(path):
    return str(path).replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%").replace("$", "$$")


def main():
    parser = argparse.ArgumentParser(description="Install user-session broker activation and an agent timer")
    parser.add_argument("runtime", type=Path)
    parser.add_argument("--compat-os", choices=["ubuntu24.04"], default="")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise SystemExit("Install user activation as the desktop user, never root.")
    runtime = args.runtime.expanduser().resolve()
    info = runtime.stat()
    if info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise SystemExit("The user runtime must be owned by this user with mode 0700.")
    if not (runtime / "run").is_file() or not os.access(runtime / "run", os.X_OK):
        raise SystemExit("An existing verified runtime is required.")
    if "log_mounts=(--tmpfs /run/systemd/journal)" not in (runtime / "run").read_text():
        raise SystemExit("This runtime launcher lacks private agent logging isolation; review the launcher update first.")
    if any(character in str(runtime) for character in ("\n", "\r", "\0")):
        raise SystemExit("Unsupported runtime path.")
    source = Path(__file__).resolve().parents[1] / "runtime"
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    replacements = {"@RUNTIME@": unit_argument(runtime), "@COMPAT_OS@": args.compat_os}
    files = {}
    for template, name in (("user-broker.service.in", "microsoft-identity-broker.service"),
                           ("user-agent.service.in", "intune-agent.service"),
                           ("user-agent.timer", "intune-agent.timer")):
        content = (source / template).read_text()
        for key, value in replacements.items():
            content = content.replace(key, value)
        files[config / "systemd/user" / name] = content
    files[data / "dbus-1/services/com.microsoft.identity.broker1.service"] = (
        source / "user-broker-activation.service").read_text()
    for name in ("agent-checkin.py", "probe-native-messaging.py", "verify-startup.py"):
        files[runtime / name] = (source / name).read_text()
    for path, content in files.items():
        if path.is_symlink() or (path.exists() and path.read_text() != content):
            raise SystemExit(f"Refusing to overwrite a conflicting existing file: {path.name}")
    if args.dry_run:
        print("User startup paths validated; no files changed.")
        return
    os.umask(0o077)
    with tempfile.TemporaryDirectory(prefix="intune-startup-") as directory:
        units = []
        for path, content in files.items():
            if path.parent == config / "systemd/user":
                draft = Path(directory) / path.name
                draft.write_text(content)
                units.append(str(draft))
        subprocess.run(["systemd-analyze", "--user", "verify", *units], check=True)
    for path, content in files.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            with path.open("x") as output:
                output.write(content)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemd-analyze", "--user", "verify",
                    str(config / "systemd/user/microsoft-identity-broker.service"),
                    str(config / "systemd/user/intune-agent.service"),
                    str(config / "systemd/user/intune-agent.timer")], check=True)
    subprocess.run(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                    "org.freedesktop.DBus", "ReloadConfig"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "microsoft-identity-broker.service",
                    "intune-agent.timer"], check=True)
    print("Broker and timer enabled for graphical login; user D-Bus activation installed.")
    print("Stop only the old manually launched broker before starting its replacement service.")
    print("Then start microsoft-identity-broker.service and intune-agent.timer.")
    if args.compat_os:
        print("Agent persists the explicitly selected Intune-only Ubuntu identity; host OS is unchanged.")


if __name__ == "__main__":
    main()
