#!/usr/bin/env python3
import ctypes
import errno
import os
from pathlib import Path
import platform
import subprocess
import sys
import tempfile

if len(sys.argv) != 2 or platform.machine() != "aarch64":
    raise SystemExit("Usage: verify-seccomp RUNTIME (native ARM64 Linux only)")
runtime = Path(sys.argv[1]).resolve()
environment = os.environ.copy()
environment["PYTHONHOME"] = str(runtime / "rootfs/usr")
os.umask(0o077)
with tempfile.TemporaryDirectory(prefix="intune-seccomp-") as directory:
    path = Path(directory) / "native-filter.bpf"
    subprocess.run([
        str(runtime / "run"), str(runtime / "rootfs/usr/bin/python3.12"),
        str(runtime / "probe-seccomp.py"), str(path),
    ], env=environment, check=True)
    child = os.fork()
    if child == 0:
        try:
            data = path.read_bytes()
            if not data or len(data) % 8:
                raise RuntimeError("Invalid native BPF length")
            buffer = ctypes.create_string_buffer(data)

            class Program(ctypes.Structure):
                _fields_ = [("length", ctypes.c_ushort), ("filter", ctypes.c_void_p)]

            program = Program(len(data) // 8, ctypes.addressof(buffer))
            libc = ctypes.CDLL(None, use_errno=True)
            libc.prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong,
                                   ctypes.c_ulong, ctypes.c_ulong]
            libc.syscall.restype = ctypes.c_long
            if libc.prctl(38, 1, 0, 0, 0) != 0:
                raise OSError(ctypes.get_errno(), "PR_SET_NO_NEW_PRIVS failed")
            if libc.prctl(22, 2, ctypes.addressof(program), 0, 0) != 0:
                raise OSError(ctypes.get_errno(), "Native filter installation failed")
            for number, arguments in ((172, ()), (57, (99999,))):
                ctypes.set_errno(0)
                if libc.syscall(number, *arguments) != -1 or ctypes.get_errno() != errno.EPERM:
                    raise RuntimeError("Native unconditional/argument-filtered denial was not enforced")
            ctypes.set_errno(0)
            if libc.syscall(57, 99998) != -1 or ctypes.get_errno() != errno.EBADF:
                raise RuntimeError("The argument-filtered rule also denied a nonmatching close")
            os._exit(0)
        except (OSError, RuntimeError) as error:
            print(str(error), file=sys.stderr, flush=True)
            os._exit(1)
    _, status = os.waitpid(child, 0)
    if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0:
        raise RuntimeError("Disposable native seccomp child failed")
print("Kernel denied native getpid and close(99999) using translated guest rules")
